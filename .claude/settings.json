{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git pull origin main)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(gh issue create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh label list *)",
      "Bash(codex exec *)",
      "Edit(/src/**)",
      "Write(/src/**)",
      "Edit(/.claude/todos/**)",
      "Write(/.claude/todos/**)"
    ],
    "ask": [
      "Edit(/docs/**)",
      "Write(/docs/**)",
      "Edit(/pom.xml)",
      "Write(/pom.xml)"
    ],
    "deny": [
      "Bash(mvn *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-implementer.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-disabled-test.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
